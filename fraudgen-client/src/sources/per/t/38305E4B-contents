theta1 <- 0.7; theta2 <- -0.4
D <- 1 + theta1^2 + theta2^2
rho <- c(1, theta1*(1+theta2)/D, theta2/D, rep(0, 17))
for(k in 0:10) cat(sprintf("rho[%2d] = %.6f\n", k, rho[k+1]))
plot(0:20, rho[1:21], type="h", lwd=2, main="Theoretical ACF (MA(2))",
     xlab="Lag", ylab=expression(rho[k])); abline(h=0, lty=2)

