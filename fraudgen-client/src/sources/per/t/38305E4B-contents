#7c
# Build theoretical acf up to L using ARMAacf
L <- 20
r <- ARMAacf(ar = NULL, ma = c(0.7, -0.4), lag.max = L)  # r[1]=rho0=1
# Durbin–Levinson to get theoretical PACF
pacf.theory <- numeric(L); v <- 1
phi <- matrix(0, L, L)
for(k in 1:L){
  if(k == 1){
    phi[k,k] <- r[2]     # rho1
  } else {
    num <- r[k+1] - sum(phi[k-1,1:(k-1)] * rev(r[2:k]))
    phi[k,k] <- num / v
    for(j in 1:(k-1)) phi[k,j] <- phi[k-1,j] - phi[k,k]*phi[k-1,k-j]
  }
  v <- v * (1 - phi[k,k]^2)
  pacf.theory[k] <- phi[k,k]
}
for(k in 1:10) cat(sprintf("phi_theory[%2d] = %.6f\n", k, pacf.theory[k]))
plot(1:L, pacf.theory, type="h", lwd=2, main="Theoretical PACF (MA(2))",
     xlab="Lag", ylab=expression(phi[kk])); abline(h=0, lty=2)

