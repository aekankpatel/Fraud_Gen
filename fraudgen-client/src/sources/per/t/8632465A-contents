getSymbols("AMZN", from = "2021-01-01", to = "2021-12-31", auto.assign = TRUE)
write.csv(AMZN, "AMZN_2021.csv", row.names = TRUE)

# Q2. Calculate weekly log returns based on adjusted close price.
adj_close <- AMZN$AMZN.Adjusted
weekly_prices <- period.apply(adj_close, INDEX = endpoints(adj_close, on = "weeks"), FUN = last)
weekly_prices
weekly_log_returns <- diff(log(weekly_prices))
weekly_log_returns

# Q3. Calculate median, mean, standard deviation of log returns.
median_return <- median(weekly_log_returns, na.rm = TRUE)
median_return
mean_return <- mean(weekly_log_returns, na.rm = TRUE)
mean_return
sd_return <- sd(weekly_log_returns, na.rm = TRUE)
sd_return

# Q4. Plot the distribution of stock daily log returns.
adj_close <- AMZN$AMZN.Adjusted
daily_log_returns <- diff(log(adj_close))
hist(daily_log_returns, breaks = 20,
     main = "AMZN Daily Log Returns",
     xlab = "Log Return", col = "lightgray", border = "black")

# Q5. Count how many observation in this series whose log return is between
#0.01 and 0.015.

# Weekly
sum(weekly_log_returns > 0.01 & weekly_log_returns < 0.015, na.rm = TRUE)

