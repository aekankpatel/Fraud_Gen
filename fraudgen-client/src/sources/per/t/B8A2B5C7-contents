# 6a
```{r}
phi1 <- 0.7; phi2 <- -0.4; max.lag <- 20
rho <- numeric(max.lag + 1)
rho[1] <- phi1 / (1 - phi2)
rho[2] <- phi1 * rho[1] + phi2
for (k in 3:(max.lag + 1)) rho[k] <- phi1*rho[k-1] + phi2*rho[k-2]
rho <- c(1, rho[1:max.lag])   # include rho0

# Print values
for (k in 0:max.lag) cat(sprintf("rho[%2d] = %.4f\n", k, rho[k+1]))

# Plot theoretical ACF
plot(0:max.lag, rho, type="h", lwd=2, col="blue",
     main="Theoretical ACF for AR(2): phi1=0.7, phi2=-0.4",
     xlab="Lag (k)", ylab=expression(rho[k]))
abline(h=0, lty=2)
```

