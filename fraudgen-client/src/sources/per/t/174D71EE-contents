# Q3: Simulating AR(2) series
```{r}
set.seed(1)
n  <- 60
x  <- arima.sim(model = list(ar = c(0.6, 0.3)), n = n)
```

# Q3a: MoM
```{r}
acf_vals <- acf(x, plot = FALSE)$acf
r1 <- acf_vals[2]
r2 <- acf_vals[3]

phi2_MOM <- (r2 - r1^2) / (1 - r1^2)
phi1_MOM <- r1 - r1 * phi2_MOM
c(phi1_MOM, phi2_MOM)
```

# Q3b: CSE
```{r}
fit_css <- arima(x, order = c(2,0,0), method = "CSS")
phi_CSS <- fit_css$coef[1:2]     
phi_CSS
```

# Q3c: MLE
```{r}
fit_ml  <- arima(x, order = c(2,0,0), method = "ML")
phi_ML  <- fit_ml$coef[1:2]
phi_ML
```

